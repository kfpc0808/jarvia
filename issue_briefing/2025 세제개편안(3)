            margin: 0; font-size: 18px; color: var(--primary-color);
            display: flex; align-items: center; gap: 12px;
        }
        .strategy-header .icon { font-size: 1.3em; }
        .strategy-list { list-style: none; margin: 0; padding: 0; }
        .strategy-list li { display: flex; gap: 20px; padding: 25px; }
        .strategy-list li:not(:last-child) { border-bottom: 1px dashed var(--border-color); }
        .item-icon { font-size: 2em; padding-top: 5px; }
        .item-content { flex: 1; }
        .item-content h4 {
            font-size: 16px; font-weight: 600;
            color: var(--primary-color); margin: 0 0 8px 0;
        }
        .item-content p { font-size: 15px; margin: 0; line-height: 1.7; color: var(--text-color-light); }
        .strategy-warning {
            display: flex; gap: 20px; padding: 25px;
            background-color: #fffaf0; border-top: 2px solid #ffd37a;
        }
        .strategy-warning .item-content h4 { color: #b95000; }

        /* --- FAQ 섹션 --- */
        .faq-section h2 { margin-bottom: 25px; }
        .faq-section details {
            background-color: #fff; border: 1px solid var(--border-color);
            border-radius: var(--border-radius-main); margin-bottom: 12px;
            transition: all 0.3s ease; box-shadow: var(--shadow-soft);
        }
        .faq-section details[open] { box-shadow: var(--shadow-medium); border-color: var(--secondary-color); }
        .faq-section summary {
            font-size: 17px; font-weight: 600; padding: 20px 25px; cursor: pointer;
            outline: none; display: flex; align-items: center; justify-content: space-between;
            color: var(--primary-color); transition: background-color 0.2s ease; list-style: none;
        }
        .faq-section summary::-webkit-details-marker { display: none; }
        .faq-section details[open] summary { background-color: var(--info-bg); }
        .faq-section summary .faq-question-text::before {
            content: 'Q.'; font-weight: 700; margin-right: 12px;
            color: var(--secondary-color); font-size: 1.1em;
        }
        .faq-section summary::after {
            content: '+'; font-size: 28px; font-weight: 300;
            transition: transform 0.3s ease; color: var(--secondary-color); line-height: 1;
        }
        .faq-section details[open] summary::after { transform: rotate(45deg); }
        .faq-section .answer {
            padding: 10px 30px 25px 65px; background-color: #ffffff;
            border-top: 1px solid var(--border-color); color: var(--text-color-light);
        }
        
        /* --- 푸터 --- */
        .footer {
            text-align: center; padding: 40px; font-size: 13px; color: rgba(255, 255, 255, 0.7);
            background-color: var(--primary-color); line-height: 1.8;
        }
        .footer p { margin: 0; padding: 0; }
        .footer strong { color: #ffffff; font-weight: 600; }
        .footer p:first-child { margin-bottom: 15px; font-size: 14px; }
        
        /* --- 반응형 --- */
        @media (max-width: 768px) {
            body { background-color: #fff; }
            .container { margin: 0; border-radius: 0; box-shadow: none; }
            .header { padding: 40px 25px; }
            .content { padding: 40px 25px; }
        }

/* --- 시장 동향 설명 박스 스타일 --- */
