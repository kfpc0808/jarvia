        }
        .header .subtitle {
            font-size: 16px; font-weight: 300; opacity: 0.9;
            margin: 0; line-height: 1.6;
        }
        .download-section {
            padding: 30px 40px; text-align: center; background-color: var(--light-gray);
            border-bottom: 1px solid var(--border-color);
        }
        .download-section p {
            margin: 0 0 18px 0; font-size: 17px;
            font-weight: 500; color: var(--primary-color);
        }
        .download-btn {
            display: inline-flex; align-items: center; gap: 10px;
            background: linear-gradient(135deg, var(--secondary-color), var(--primary-color));
            color: #ffffff; padding: 12px 30px; border-radius: 50px;
            text-decoration: none; font-weight: 600; font-size: 16px;
            box-shadow: 0 4px 15px rgba(26, 95, 153, 0.25);
            transition: all 0.3s ease;
        }
        .download-btn::before { content: '📥'; font-size: 1.1em; }
        .download-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 7px 20px rgba(26, 95, 153, 0.35);
        }
        
        /* --- 메인 콘텐츠 --- */
        .content { padding: 50px 40px; }
        .content p, .content ul { margin: 0 0 1.5em; color: var(--text-color-light); }
        .content p:last-child, .content ul:last-child { margin-bottom: 0; }
        .content > .section:last-child { margin-bottom: 0; }
        .section { margin-bottom: 60px; }
        .section h2 {
            font-size: 26px; font-weight: 700; color: var(--primary-color);
            border-left: 5px solid var(--secondary-color);
            padding-left: 20px; margin: 0 0 35px 0;
            display: flex; align-items: center; line-height: 1.4;
        }
        .section h2 .icon {
            margin-right: 15px; font-size: 1.5em; display: inline-flex;
            align-items: center; justify-content: center; width: 40px; height: 40px;
            background-color: var(--accent-color); border-radius: 50%;
        }
        
        /* --- 정보 카드 --- */
        .info-card {
            background-color: #ffffff; border: 1px solid var(--border-color);
            border-radius: var(--border-radius-main); margin: 25px 0;
            box-shadow: var(--shadow-soft);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .info-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-medium); }
        .info-card h3 {
            font-size: 20px; font-weight: 600; color: var(--primary-color);
            margin: 0; padding: 20px 25px;
            border-bottom: 1px solid var(--border-color);
            background-color: var(--light-gray);
        }
        .info-card .card-content { padding: 25px; }
        .info-card ul { list-style: none; padding-left: 0; }
        .info-card ul li { padding-left: 30px; position: relative; }
        .info-card ul li:not(:last-child){ margin-bottom: 1.2em; }
        .info-card ul li::before {
            content: '✓'; color: #ffffff; background-color: var(--secondary-color);
            font-weight: bold; display: inline-flex; align-items: center; justify-content: center;
            position: absolute; left: 0; top: 3px;
            width: 20px; height: 20px; border-radius: 50%; font-size: 12px;
        }
        .info-card ul ul { margin-top: 1em; padding-left: 10px; }
        .info-card ul ul li::before { content: '•'; background: none; color: var(--secondary-color); font-size: 18px; top: 0; }

        /* --- 메시지 박스 & 팁 박스 --- */
        .key-message-box {
            background-color: var(--info-bg); border-left: 6px solid var(--secondary-color);
            padding: 30px; border-radius: 8px; margin-top: 30px;
        }
        .key-message-box h3 {
            font-size: 20px; color: var(--primary-color);
            margin: 0 0 15px 0; display: flex; align-items: center;
        }
        .tip-box {
            border-radius: var(--border-radius-main);
            padding: 25px; margin-bottom: 25px; font-size: 16px;
        }
        .tip-box strong.title {
            font-weight: 700; display: flex; align-items: center;
            font-size: 1.1em; margin: 0 0 15px 0;
        }
        .tip-box.danger {
            background-color: var(--danger-bg); border: 1px solid #ffcdd2;
            border-left: 5px solid var(--danger-color);
        }
        .tip-box.danger strong.title { color: var(--danger-color); }
        
        /* --- 테이블 --- */
        .table-scroll-wrapper { overflow-x: auto; margin: 1em 0; }
        table {
            width: 100%; border-collapse: collapse; font-size: 15px;
            border: 1px solid var(--border-color); border-radius: var(--border-radius-main);
            overflow: hidden;
        }
        th, td {
            padding: 14px 18px; text-align: left;
            border-bottom: 1px solid var(--border-color); vertical-align: middle;
        }
        th {
            background-color: var(--light-gray); font-weight: 600; color: var(--primary-color);
            text-align: center; border-bottom: 2px solid var(--border-color);
        }
        tbody tr { transition: background-color 0.2s ease; }
        tbody tr:nth-child(even) { background-color: var(--info-bg); }
        tbody tr:hover { background-color: var(--accent-color); }
        tr:last-child td { border-bottom: none; }
        
        /* --- 텍스트 스타일 & 기타 --- */
        b, strong, .text-primary { font-weight: 600; color: var(--primary-color); }
