        :root {
            --primary-color: #0d2c54;
            --secondary-color: #1a5f99;
            --accent-color: #d1e3ff;
            --text-color: #343a40;
            --text-color-light: #495057;
            --light-gray: #f8f9fa;
            --border-color: #e9ecef;
            --highlight-bg: #fff3bf;
            --danger-color: #c62828;
            --danger-bg: #ffebee;
            --info-bg: #f1f6fb;
            --shadow-soft: 0 4px 12px rgba(0, 0, 0, 0.06);
            --shadow-medium: 0 8px 24px rgba(0, 0, 0, 0.08);
            --border-radius-main: 12px;
        }

        /* --- 기본 스타일 & 레이아웃 --- */
        body {
            font-family: 'Noto Sans KR', sans-serif; margin: 0; padding: 0;
            background-color: var(--light-gray); color: var(--text-color);
            line-height: 1.8; word-break: keep-all;
            -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
        }
        .container {
            max-width: 800px; margin: 0 auto 20px; background-color: #ffffff;
            box-shadow: var(--shadow-medium); border-radius: var(--border-radius-main);
            overflow: hidden;
        }
        
        /* --- 헤더 & 다운로드 --- */
        .header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: #ffffff; padding: 50px 40px;
        }
        .header .tag {
            display: inline-block; background-color: rgba(255, 255, 255, 0.15);
            color: #ffffff; padding: 8px 18px; border-radius: 20px;
